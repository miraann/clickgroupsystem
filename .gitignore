# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-offline/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron-app
electron-app/node_modules
electron-app/build
electron-app/dist

# staged release assets (built locally, uploaded to GitHub Releases)
dist-release/

# offline edition — downloaded PostgreSQL/PostgREST binaries and local dev data
offline/vendor/
offline/.data*/
offline/node_modules/

# offline desktop app — staged resources and installers (built locally)
electron-offline/stage/
electron-offline/dist/
electron-offline/node_modules/

# dependencies in any sub-project (marketing/promo-video, …)
node_modules/
# the licence *public* key is meant to be shared (the private half is never in the repo)
!offline/runtime/license-public.pem
