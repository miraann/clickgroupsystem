{
  "name": "clickgroup-pos",
  "version": "1.0.1",
  "description": "ClickGroup POS — Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "SET ELECTRON_RUN_AS_NODE=&& electron .",
    "build:win": "electron-builder --win",
    "release:win": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.clickgroup.pos",
    "productName": "ClickGroup POS",
    "publish": [
      {
        "provider": "github",
        "owner": "miraann",
        "repo": "clickgroupsystem"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  }
}
